{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": ["esnext"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  // Matches the other packages, which type-check their sources and not their
  // build configuration: vitest.config.ts imports the shared base from another
  // package, whose dev dependencies are not resolvable from here.
  "include": ["generator", "harness", "tools"],
  "exclude": ["node_modules"]
}
