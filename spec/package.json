{
  "name": "@ag-ui/spec",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "The AG-UI protocol contract as JSON Schema, and the suite that checks it. Never published: the artifact is the schema file, served on the web.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ag-ui-protocol/ag-ui.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"harness/**/*.ts\" \"tools/**/*.ts\" \"generator/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "reconcile": "tsx tools/reconcile.ts",
    "clean": "git clean -fdX --exclude=\"!.env\"",
    "generate": "tsx generator/generate.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.21",
    "ajv": "^8.17.1",
    "eslint": "^9.37.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^4.0.18",
    "prettier": "^3.5.3"
  },
  "nx": {
    "targets": {
      "test": {
        "cache": false
      }
    }
  }
}
