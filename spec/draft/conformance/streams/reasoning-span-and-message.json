{
  "name": "reasoning-span-and-message",
  "area": "reasoning",
  "description": "a span bracketing one reasoning message assembles into a reasoning-role message in history, alongside the answer it preceded",
  "specPage": "/spec/draft/events/reasoning",
  "kill": "make the reducer drop reasoning messages instead of materialising them into the conversation",
  "stream": [
    {
      "type": "RUN_STARTED",
      "threadId": "t-reasoning-span",
      "runId": "r-reasoning-span",
      "protocolVersion": "1.0"
    },
    { "type": "REASONING_START", "messageId": "span-reasoning-span-1" },
    {
      "type": "REASONING_MESSAGE_START",
      "messageId": "m-reasoning-span-1",
      "role": "reasoning"
    },
    {
      "type": "REASONING_MESSAGE_CONTENT",
      "messageId": "m-reasoning-span-1",
      "delta": "weighing "
    },
    {
      "type": "REASONING_MESSAGE_CONTENT",
      "messageId": "m-reasoning-span-1",
      "delta": "the options"
    },
    { "type": "REASONING_MESSAGE_END", "messageId": "m-reasoning-span-1" },
    { "type": "REASONING_END", "messageId": "span-reasoning-span-1" },
    {
      "type": "TEXT_MESSAGE_START",
      "messageId": "m-reasoning-span-2",
      "role": "assistant"
    },
    {
      "type": "TEXT_MESSAGE_CONTENT",
      "messageId": "m-reasoning-span-2",
      "delta": "the answer"
    },
    { "type": "TEXT_MESSAGE_END", "messageId": "m-reasoning-span-2" },
    {
      "type": "RUN_FINISHED",
      "threadId": "t-reasoning-span",
      "runId": "r-reasoning-span"
    }
  ],
  "expect": {
    "outcome": "completed",
    "noWarnings": true,
    "messageCount": 2,
    "messages": [
      {
        "id": "m-reasoning-span-1",
        "role": "reasoning",
        "content": "weighing the options"
      },
      { "id": "m-reasoning-span-2", "role": "assistant", "content": "the answer" }
    ]
  },
  "expectOverrides": {
    "dotnet": {
      "intentional": "Microsoft.Extensions.AI models reasoning as TextReasoningContent on an assistant message; there is no reasoning role on the .NET conversation surface, and AsAGUIMessages projects only TextContent into `content`. Both messages and their ids and order match — the role and the reasoning text are what this lane cannot express.",
      "messages": [
        {
          "id": "m-reasoning-span-1",
          "role": "assistant"
        },
        {
          "id": "m-reasoning-span-2",
          "role": "assistant",
          "content": "the answer"
        }
      ]
    }
  }
}
