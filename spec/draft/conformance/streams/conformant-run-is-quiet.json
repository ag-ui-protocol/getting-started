    { "type": "TEXT_MESSAGE_END", "messageId": "m-1" },
    { "type": "STATE_SNAPSHOT", "snapshot": { "answered": true } },
    { "type": "STEP_FINISHED", "stepName": "answer" },
    { "type": "RUN_FINISHED", "threadId": "t-clean", "runId": "r-1" }
