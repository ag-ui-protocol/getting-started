{
  "name": "unknown-event-dropped",
  "area": "processing",
  "description": "an event type the client does not recognise is dropped with a warning and the run survives",
  "specPage": "/spec/draft/basic/processing",
  "kill": "make enforcement pass unrecognised event types through, or fail the run on one",
  "stream": [
    { "type": "RUN_STARTED", "threadId": "t-unknown-event", "runId": "r-1" },
    { "type": "TEXT_MESSAGE_START", "messageId": "m-1", "role": "assistant" },
    { "type": "TEXT_MESSAGE_CONTENT", "messageId": "m-1", "delta": "before" },
    { "type": "FUTURE_EVENT", "somethingNew": true },
    { "type": "TEXT_MESSAGE_CONTENT", "messageId": "m-1", "delta": " and after" },
    { "type": "TEXT_MESSAGE_END", "messageId": "m-1" },
    { "type": "RUN_FINISHED", "threadId": "t-unknown-event", "runId": "r-1" }
  ],
  "expect": {
    "outcome": "completed",
    "warnings": ["FUTURE_EVENT"],
    "messageCount": 1,
    "messages": [{ "role": "assistant", "content": "before and after" }]
  }
}
