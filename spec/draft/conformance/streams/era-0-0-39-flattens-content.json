{
  "name": "era-0-0-39-flattens-content",
  "area": "compatibility",
  "description": "a 0.0.39 peer receives flattened text content, and the parts it cannot receive are reported rather than dropped in silence",
  "specPage": "/spec/draft/basic/versioning",
  "kill": "remove BackwardCompatibility_0_0_39, its version gate, or its dropped-parts warning",
  "client": { "maxProtocolVersion": "0.0.39" },
  "input": {
    "messages": [
      {
        "id": "era39-u1",
        "role": "user",
        "content": [
          { "type": "text", "text": "What is in this picture?" },
          {
            "type": "image",
            "source": {
              "type": "url",
              "value": "https://example.com/cat.png",
              "mimeType": "image/png"
            }
          }
        ]
      }
    ]
  },
  "stream": [
    { "type": "RUN_STARTED", "threadId": "t-era39", "runId": "r-1" },
    { "type": "TEXT_MESSAGE_START", "messageId": "era39-m1", "role": "assistant" },
    { "type": "TEXT_MESSAGE_CONTENT", "messageId": "era39-m1", "delta": "A cat." },
    { "type": "TEXT_MESSAGE_END", "messageId": "era39-m1" },
    { "type": "RUN_FINISHED", "threadId": "t-era39", "runId": "r-1" }
  ],
  "expect": {
    "outcome": "completed",
    "warnings": ["DROPS non-text parts"],
    "request": {
      "messages": [
        { "id": "era39-u1", "role": "user", "content": "What is in this picture?" }
      ]
    }
  },
  "expectOverrides": {
    "dotnet": {
      "intentional": "The compatibility shims are TypeScript client middleware; the .NET client has no equivalent, so it sends the message unflattened and emits no warning. Alignment is tracked separately.",
      "warnings": [],
      "request": {}
    }
  }
}
