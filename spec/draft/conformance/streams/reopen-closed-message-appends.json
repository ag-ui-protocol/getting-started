{
  "name": "reopen-closed-message-appends",
  "area": "streaming",
  "description": "a closed message is closed, not sealed — a second TEXT_MESSAGE_START for the same id continues it and further content appends",
  "specPage": "/spec/draft/events/text-messages",
  "kill": "make the reducer's TEXT_MESSAGE_START branch push a new message unconditionally instead of resolving the existing id",
  "stream": [
    { "type": "RUN_STARTED", "threadId": "t-reopen", "runId": "reopen-r1", "protocolVersion": "1.0" },
    { "type": "TEXT_MESSAGE_START", "messageId": "reopen-m1", "role": "assistant" },
    { "type": "TEXT_MESSAGE_CONTENT", "messageId": "reopen-m1", "delta": "First half." },
    { "type": "TEXT_MESSAGE_END", "messageId": "reopen-m1" },
    { "type": "TEXT_MESSAGE_START", "messageId": "reopen-m1", "role": "assistant" },
    { "type": "TEXT_MESSAGE_CONTENT", "messageId": "reopen-m1", "delta": " Second half." },
    { "type": "TEXT_MESSAGE_END", "messageId": "reopen-m1" },
    { "type": "RUN_FINISHED", "threadId": "t-reopen", "runId": "reopen-r1" }
  ],
  "expect": {
    "outcome": "completed",
    "noWarnings": true,
    "messageCount": 1,
    "messages": [{ "id": "reopen-m1", "role": "assistant", "content": "First half. Second half." }]
  }
}
