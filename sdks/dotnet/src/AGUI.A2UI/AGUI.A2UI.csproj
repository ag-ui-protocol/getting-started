<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworksCore)</TargetFrameworks>
    <RootNamespace>AGUI.A2UI</RootNamespace>
    <PackageId>AGUI.A2UI</PackageId>
    <Description>A2UI (agent-generated UI) IChatClient adapter for the AG-UI protocol: injects the generate_a2ui tool, drives a render_a2ui subagent with a validate-and-retry recovery loop (from AGUI.A2UI.Toolkit), and streams surfaces progressively.</Description>
    <PackageTags>$(PackageTags);a2ui;generative-ui;adapter;streaming;chat;microsoft-extensions-ai</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="AGUI.A2UI.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The framework-agnostic validation / recovery / envelope primitives. -->
    <ProjectReference Include="..\AGUI.A2UI.Toolkit\AGUI.A2UI.Toolkit.csproj" />
    <ProjectReference Include="..\AGUI.Abstractions\AGUI.Abstractions.csproj" />
    <!-- For the public ChatOptions -> RunAgentInput bridge (TryGetRunAgentInput): the
         forwarded A2UI catalog and injectA2UITool flag arrive on RunAgentInput. -->
    <ProjectReference Include="..\AGUI.Server\AGUI.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

</Project>
