{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The demos import the adapter by its package name, which only resolves
    // through its `exports` map, and the parent config uses "node" resolution.
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["server"],
  "exclude": ["node_modules"]
}
