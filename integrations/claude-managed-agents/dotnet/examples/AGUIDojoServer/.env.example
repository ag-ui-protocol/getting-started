# Template only: nothing in this repository loads a .env file. Copy it and export
# the values yourself before starting the example, e.g.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
ANTHROPIC_API_KEY=sk-ant-...
# Optional: any Managed Agents model
# MANAGED_AGENTS_MODEL=claude-sonnet-5
# Optional: listen port (default 8026). Honoured by `dotnet run` and the container.
# PORT=8026
# Optional: full listen address; overrides PORT.
# ASPNETCORE_URLS=http://0.0.0.0:8026
